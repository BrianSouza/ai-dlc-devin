{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh -c 'command -v bun >/dev/null 2>&1 || [ -x \"$HOME/.bun/bin/bun\" ] || { case \"$DEVIN_PROJECT_DIR\" in \"$HOME\"/repos/*) grep -q aidlc-devin-adapter.ts \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks.v1.json\" 2>/dev/null && curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1 ;; esac; }; PATH=\"$HOME/.bun/bin:$PATH\" exec bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" session-start'",
          "timeout": 1800
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" session-end",
          "timeout": 60
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" mint",
          "timeout": 1800
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(exec|read|write|edit|apply_patch|notebook_read|notebook_edit|grep|glob|run_subagent|ask_user_question)$",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" guards",
          "timeout": 1800
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit|run_subagent)$",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" audit-and-sensors",
          "timeout": 3600
        }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" runtime-compile",
          "timeout": 1800
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" validate-state",
          "timeout": 1800
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun \"$DEVIN_PROJECT_DIR/{{HARNESS_DIR}}/hooks/aidlc-devin-adapter.ts\" stop",
          "timeout": 3600
        }
      ]
    }
  ]
}
